# Copy to .env.local. Never commit real keys.
# Leave DEMO_MODE unset to use live sandbox + Grok when the keys below exist,
# and canned/mocked fallbacks when they do not.
# DEMO_MODE=true forces the canned planner and mocked PayPal client.
# DEMO_MODE=false requires the keys and will error instead of falling back.

DEMO_MODE=

# xAI Grok, OpenAI-compatible. https://api.x.ai/v1
XAI_API_KEY=
XAI_MODEL=grok-4
XAI_BASE_URL=https://api.x.ai/v1

# PayPal sandbox app from https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Sandbox business email that owns the REST app. Required for real invoices.
PAYPAL_MERCHANT_EMAIL=
PAYPAL_MERCHANT_NAME=Zilla Labs

# Webhook id from the sandbox app. Required to verify INVOICING.INVOICE.* events.
PAYPAL_WEBHOOK_ID=

# Optional override. Defaults to ./data/store.json, or /tmp/zilla-milestones.json on Vercel.
ZILLA_STORE_PATH=
